{
  "installCommand": "npm ci && npm run postinstall",
  "rewrites": [
    { "source": "/terms", "destination": "/api/tiktok?page=terms" },
    { "source": "/privacy", "destination": "/api/tiktok?page=privacy" },
    { "source": "/tiktok:rest*", "destination": "/api/tiktok?verify_file=tiktok:rest*" },
    { "source": "/api/tiktok/:rest*", "destination": "/api/tiktok?verify_file=:rest*" },
    { "source": "/api/video/download", "destination": "/api/video" },
    { "source": "/api/video/download/:id*", "destination": "/api/video?id=:id*" }
  ],
  "functions": {
    "api/clips.js": {
      "includeFiles": "node_modules/@involvex/**",
      "maxDuration": 90
    },
    "api/create.js": {
      "maxDuration": 90
    },
    "api/scene-image.js": {
      "maxDuration": 90
    }
  }
}
