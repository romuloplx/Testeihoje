# Opcional — se definir, o backend usará OpenAI de verdade
# Sem chave, o app funciona em modo MOCK (perfeito para demonstração)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Opcional — habilita clipes reais de 5s/720p na aba Criar via TokenHub/Tencent
# Ative o modelo HunyuanVideo e a cobrança correspondente no painel do TokenHub.
TENCENT_TOKENHUB_API_KEY=

# Opcional — prioriza FLUX.2 Pro do OpenRouter nas imagens de cena em Criar (cobrança por megapixel).
# Mantenha a chave apenas no ambiente do servidor/Vercel, nunca no frontend.
OPENROUTER_API_KEY=

# Opcional — busca oficial de vídeos do Douyin para inspiração.
# O aplicativo precisa ter a capacidade aweme.dy.video_search aprovada no Douyin Open Platform.
# Configure apenas no servidor/Vercel; nunca publique o client_secret no navegador.
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=

PORT=3000
